DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
MAPBOX_STATIC_MAPS_TOKEN=your_mapbox_token
PDF_SERVICE_URL=http://127.0.0.1:8765/render
AUTH_PERSIST_SECRET=replace-with-a-long-random-secret

# Optional: enables email notifications for the access-request workflow.
# Leave SMTP_HOST unset to skip notifications without breaking the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
APP_URL=https://app.sala-global.com

